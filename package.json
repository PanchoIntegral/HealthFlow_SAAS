{
  "name": "healthflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @healthflow/api db:generate",
    "db:migrate": "pnpm --filter @healthflow/api db:migrate",
    "db:seed": "pnpm --filter @healthflow/api db:seed",
    "db:setup": "pnpm --filter @healthflow/api db:setup"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
