# ── Base de datos ────────────────────────────────────────────────
# DB_ADMIN_URL: rol dueño de las tablas (superusuario/owner). Corre migraciones y seeds.
#   Las políticas RLS NO aplican a este rol — por eso el API NO lo usa.
DB_ADMIN_URL=postgresql://jorge@localhost:5432/healthflow

# DATABASE_URL: rol de aplicación (NO superusuario, NO dueño). El API se conecta con este.
#   Las políticas RLS SÍ aplican a este rol → aislamiento multi-tenant garantizado por la DB.
DATABASE_URL=postgresql://healthflow_app:healthflow_app_pwd@localhost:5432/healthflow

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-cambia-esto-en-produccion
JWT_EXPIRES_IN=1d

# ── API ──────────────────────────────────────────────────────────
API_PORT=3001
# CORS: lista separada por comas. Agrega tu IP local para probar desde otro
# dispositivo, p.ej.: http://localhost:3000,http://192.168.1.173:3000
# El :3100 es la landing (LD_HEALTHFLOW), que llama al checkout-session directo.
WEB_ORIGIN=http://localhost:3000,http://localhost:3100

# ── Web (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Suscripciones (Stripe) ────────────────────────────────────────
# APP_URL: a dónde manda Stripe al terminar el checkout (apps/web).
# MARKETING_URL: a dónde vuelve si cancela el checkout (LD_HEALTHFLOW).
APP_URL=http://localhost:3000
MARKETING_URL=http://localhost:3100
# Llaves de test (dashboard de Stripe → Developers → API keys / Webhooks).
STRIPE_SECRET_KEY=sk_test_xxx
# La da `stripe listen --forward-to localhost:3001/api/subscriptions/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_INDIVIDUAL=price_xxx
STRIPE_PRICE_ID_CONSULTORIO=price_xxx
# Anuales (20% de descuento sobre 12 meses)
STRIPE_PRICE_ID_INDIVIDUAL_ANUAL=price_xxx
STRIPE_PRICE_ID_CONSULTORIO_ANUAL=price_xxx

# ── Facturación (PAC) ────────────────────────────────────────────
# PAC_PROVIDER=fake usa el FakePacAdapter (sin red, sin costo) — recomendado en dev.
# Con el adaptador real, FACTURAPI_SECRET_KEY es obligatoria. Usar keys SEPARADAS
# sandbox/producción: staging SIEMPRE debe apuntar a sandbox (timbrar "de prueba"
# contra producción genera folios reales ante el SAT).
PAC_PROVIDER=fake
# FACTURAPI_SECRET_KEY=sk_test_xxx

# ── Almacenamiento de archivos (radiografías) ────────────────────
# STORAGE_PROVIDER=fake usa un adaptador en memoria (sin red, sin costo,
# no persiste al reiniciar) — recomendado en dev. Con el adaptador real,
# las 4 variables R2_* son obligatorias. Bucket PRIVADO: las imágenes se
# sirven con URLs prefirmadas de vida corta, nunca acceso público directo.
STORAGE_PROVIDER=fake
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET_NAME=healthflow-radiografias

# ── Correo transaccional (Resend) ─────────────────────────────────
# EMAIL_PROVIDER=fake usa un adaptador que solo loguea a consola (sin red,
# sin costo) — recomendado en dev: el enlace de "olvidé mi contraseña" sale
# en el log del API. Con el adaptador real, RESEND_API_KEY es obligatoria.
EMAIL_PROVIDER=fake
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=HealthFlow <noreply@tudominio.mx>

# ── Asistente de transcripción con IA (Gemini) ───────────────────
# GEMINI_PROVIDER=fake usa un adaptador simulado que devuelve una extracción de
# ejemplo (sin red, sin costo) — recomendado en dev: cada llamada real manda
# minutos de audio a Google y se cobra. Con el adaptador real, GEMINI_API_KEY
# es obligatoria (Google AI Studio → Get API key).
#
# OJO: además de la llave, cada clínica debe tener el interruptor prendido en
# la base (tenants.asistente_ia_activo). Mandar el audio de una consulta a un
# tercero es una decisión de cada consultorio, con su aviso de privacidad.
GEMINI_PROVIDER=fake
# GEMINI_API_KEY=xxx
# Modelo a usar. El catálogo de Google cambia varias veces al año; los
# disponibles para tu llave se listan con:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-2.5-flash

# ── Recordatorios de cita por WhatsApp (Meta Cloud API) ──────────
# WHATSAPP_PROVIDER=fake escribe cada mensaje al log en lugar de mandarlo
# (sin red, sin costo) — recomendado en dev, y además permite validar toda la
# lógica de tiempos, idempotencia y ruteo del webhook sin esperar a que Meta
# apruebe la plantilla (el trámite tarda de 3 días a 2 semanas).
#
# OJO con el costo: la tarifa utility en México ronda los $0.0085 USD POR
# MENSAJE, cobrada desde el primero — no hay cupo gratis. Los mensajes que
# manda el paciente no se cobran.
WHATSAPP_PROVIDER=fake
# Credenciales del número COMPARTIDO de HealthFlow. Las clínicas en modo
# 'propio' guardan las suyas cifradas en la base; estas son el respaldo para
# las que están en modo 'compartido' (todas, durante el piloto).
# WHATSAPP_PHONE_NUMBER_ID=xxx
# WHATSAPP_ACCESS_TOKEN=EAAxxx
# Secreto de la app de Meta. Firma el webhook: sin él, cualquiera podría
# cancelar citas ajenas mandando un POST. Se verifica ANTES de leer el body.
# WHATSAPP_APP_SECRET=xxx
# Token del handshake de verificación del webhook. Lo elige uno, no Meta:
# genera una cadena larga al azar y pégala también en el panel de Meta.
# WHATSAPP_VERIFY_TOKEN=xxx
# WHATSAPP_GRAPH_VERSION=v21.0
# Llavero para cifrar el access token de las clínicas con número propio
# (AES-256-GCM). Genera una llave con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotar = agregar una llave nueva y cambiar la activa; lo viejo se sigue
# descifrando con la suya, sin migración de datos.
# WHATSAPP_TOKEN_KEYS={"k1":"<32 bytes en base64>"}
# WHATSAPP_TOKEN_KEY_ACTIVE=k1
# Cada cuánto barre el scheduler (ms) y si corre. 'off' lo apaga; en tests
# está apagado por default para que no toque la base durante otros specs.
# WHATSAPP_SCHEDULER_INTERVAL_MS=120000
# WHATSAPP_SCHEDULER=on

# ── Endurecimiento HTTP / anti-abuso ─────────────────────────────
# Saltos de proxy de confianza para resolver la IP real del cliente. DEBE
# coincidir con la infraestructura o los límites por IP dejan de funcionar:
#   0 → proceso expuesto directo (dev local)
#   1 → un balanceador delante (Railway, Render, Fly) ← valor por defecto en producción
#   2 → CDN + PaaS (p.ej. Cloudflare → Railway)
# Pasarse permite falsificar la IP con X-Forwarded-For y esquivar los límites;
# quedarse corto hace que todos los usuarios compartan el cubo del proxy.
TRUST_PROXY_HOPS=0
# Tamaño máximo del body JSON aceptado.
MAX_BODY_SIZE=256kb
